{
  "folders": [
    {
      "path": ".",
    },
  ],

  "settings": {
    // editor
    "editor.defaultFormatter": "biomejs.biome",
    "editor.rulers": [100],
    "editor.tabSize": 2,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
      "source.fixAll.stylelint": "always",
      "source.fixAll.eslint": "never",
      "source.fixAll.oxc": "always",
      "source.fixAll.biome": "always",
      "source.organizeImports.biome": "always",
    },

    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/node_modules/**": true,
      "**/.hg/store/**": true,
      "yarn.lock": true,
    },

    "search.exclude": {
      "**/node_modules": true,
      "**/bower_components": true,
      "**/*.code-search": true,
      ".yarn": true,
      "yarn.lock": true,
    },
  },

  "extensions": {
    "recommendations": [
      "biomejs.biome",
      "oxc.oxc-vscode",
      "KnisterPeter.vscode-commitizen",
      "arcanis.vscode-zipfs",
    ],
  },

  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Check TypeScript types",
        "type": "shell",
        "command": "yarn",
        "args": ["types", "--pretty", "false"],
        "options": { "cwd": "${workspaceFolder}" },
        "problemMatcher": "$tsc",
      },
    ],
  },

  "launch": {
    "configurations": [
      {
        "name": "current TS file",
        "type": "node",
        "request": "launch",
        "args": ["${relativeFile}"],
        "sourceMaps": true,
        "runtimeArgs": ["--nolazy", "--import", "tsx"],
        "preLaunchTask": "Check TypeScript types",
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen",
        "runtimeExecutable": "node",
        "cwd": "${workspaceRoot}",
      },
      {
        "name": "current TS test file",
        "type": "node",
        "request": "launch",
        "program": "${workspaceRoot}/node_modules/.bin/jest",
        "args": ["--runInBand", "--no-cache", "${relativeFile}"],
        "sourceMaps": true,
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen",
        "runtimeExecutable": "node",
        "cwd": "${workspaceRoot}",
      },
      {
        "name": "current TS test file with selected text as test name",
        "type": "node",
        "request": "launch",
        "program": "${workspaceRoot}/node_modules/.bin/jest",
        "args": ["--runInBand", "--no-cache", "-t", "${selectedText}", "${relativeFile}"],
        "sourceMaps": true,
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen",
        "runtimeExecutable": "node",
        "cwd": "${workspaceRoot}",
      },
    ],
  },
}
