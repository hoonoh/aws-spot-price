{
  "compilerOptions": {
    "module": "node16",
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": ["node", "jest"],
    "moduleResolution": "node16",
    "strict": true,
    "strictPropertyInitialization": false,
    "sourceMap": true,
    "rootDir": ".",
    "sourceRoot": "src",
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules"]
}
