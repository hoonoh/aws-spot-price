{
  "name": "aws-spot-price",
  "version": "1.1.151",
  "description": "CLI utility to list current global AWS EC2 Spot Instance prices.",
  "keywords": [
    "aws",
    "ec2",
    "spot",
    "instance",
    "price",
    "prices",
    "pricing"
  ],
  "bugs": {
    "url": "https://github.com/hoonoh/aws-spot-price/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hoonoh/aws-spot-price"
  },
  "author": {
    "name": "hoonoh"
  },
  "packageManager": "yarn@4.18.1",
  "bin": "bin/aws-spot-price",
  "main": "dist/module.js",
  "types": "dist/module.d.ts",
  "license": "MIT",
  "scripts": {
    "prepublishOnly": "yarn clean && yarn build && yarn build:types && ts-node -T ./scripts/pre-publish.ts",
    "prepare": "husky install",
    "clean": "rm -rf dist && rm -rf coverage",
    "build:ec2-info": "ts-node -T scripts/generate-ec2-info.ts",
    "build:ec2-types": "ts-node -T scripts/generate-ec2-types.ts",
    "build:regions": "ts-node -T scripts/generate-regions.ts",
    "build:types": "tsc -p tsconfig.types.json",
    "build:cli": "yarn esbuild --outdir=./dist --platform=node --format=cjs --bundle --minify --main-fields=main,module --sources-content=false ./src/cli.ts",
    "build:module": "yarn esbuild --outdir=./dist --platform=node --format=cjs --bundle --minify --main-fields=main,module --sources-content=false ./src/module.ts",
    "build": "yarn build:cli && yarn build:module",
    "changelog": "conventional-changelog -i CHANGELOG.md -s -p angular",
    "test": "NODE_OPTIONS=--max_old_space_size=8192 jest --runInBand --verbose",
    "test:coverage": "yarn test --coverage",
    "test:ci": "yarn test:coverage --reporters=default jest-junit --coverageReporters lcov --coverageReporters cobertura",
    "lint": "eslint \"**/*.ts\"",
    "types": "tsc",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "ora": "5.4.1",
    "prompts": "2.4.2",
    "table": "6.9.0",
    "yargs": "17.7.3"
  },
  "devDependencies": {
    "@aws-sdk/client-ec2": "3.1141.0",
    "@aws-sdk/client-ssm": "3.1141.0",
    "@aws-sdk/client-sts": "3.1141.0",
    "@commitlint/cli": "20.5.3",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.25",
    "@types/mock-fs": "4.13.4",
    "@types/node": "24.19.0",
    "@types/prettier": "3.0.0",
    "@types/prompts": "2.4.9",
    "@types/yargs": "17.0.35",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "aws-sdk-client-mock": "4.1.0",
    "commitizen": "4.3.2",
    "conventional-changelog-cli": "5.0.0",
    "cz-conventional-changelog": "3.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-junit": "16.0.0",
    "jest-mock-console": "2.0.0",
    "lodash": "4.18.1",
    "mock-fs": "5.5.0",
    "prettier": "3.9.9",
    "semantic-release": "25.0.9",
    "ts-jest": "29.4.14",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "resolutions": {
    "@conventional-changelog/git-client": "2.7.0",
    "@tootallnate/once": "3.0.1",
    "@aws-sdk/types": "3.974.6",
    "@babel/core": "7.29.7",
    "@smithy/types": "4.19.0",
    "ajv@npm:^8.0.0": "8.20.0",
    "ansi-regex@npm:^3.0.0": "3.0.1",
    "ansi-regex@npm:^5.0.0": "5.0.1",
    "brace-expansion@npm:^1.1.7": "1.1.14",
    "diff@npm:^4.0.1": "4.0.4",
    "diff@npm:^5.0.0": "5.2.2",
    "diff@npm:^8.0.0": "8.0.4",
    "lodash": "4.18.1",
    "minimist": "1.2.8",
    "path-to-regexp": "8.4.2",
    "semver@npm:^6.0.0": "6.3.1",
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "yaml@npm:^1.10.0": "1.10.3"
  }
}
